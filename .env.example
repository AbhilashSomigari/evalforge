# Copy to .env (gitignored). Never commit real values.

# docker compose up: both values are required.
# Generate each with: openssl rand -hex 32
# (hex keeps the password URL-safe; it's embedded in EVALFORGE_DATABASE_URL.)
POSTGRES_PASSWORD=
EVALFORGE_API_KEY=
# Optional: requests per minute per client IP, counted in Postgres so the
# limit holds across replicas. Defaults to 120 in docker-compose.yml.
# EVALFORGE_RATE_LIMIT_PER_MINUTE=120
# Optional: host port for the API (bound to 127.0.0.1). Defaults to 8000.
# EVALFORGE_PORT=8000

# Example agents (examples/agents/): only the key for the agent you run.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
